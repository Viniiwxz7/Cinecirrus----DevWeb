<div class="section-heading"><div><p class="eyebrow">{{icon}} {{label}}</p><h1>{{pageTitle}}</h1></div><div class="action-links"><a class="link-pill primary" href="{{baseUrl}}/cadastrar">Cadastrar</a><a class="link-pill" href="/">Início</a></div></div>
{{#if isList}}
  <div class="notice">Esta é a tela <strong>Listar Todos</strong>. Os links abaixo abrem a tela Detalhar.</div>
  <div class="table-container mt-2"><table class="data-table"><thead><tr><th>Nome / título</th><th>Campo principal</th><th>Categoria</th><th>Ação</th></tr></thead><tbody>
    {{#each rows}}<tr><td><strong>{{title}}</strong></td><td>{{main}}</td><td><span class="chip">{{category}}</span></td><td><a class="link-pill" href="{{../baseUrl}}/{{id}}">Detalhar</a></td></tr>{{/each}}
  </tbody></table></div>
{{else if isDetail}}
  <article class="card"><div class="card__container"><span class="chip">Registro #{{row.id}}</span><h2 class="card__title">{{row.title}}</h2><p class="card__content">{{row.description}}</p><dl class="meta-list"><div><dt>Campo principal</dt><dd>{{row.main}}</dd></div><div><dt>Categoria</dt><dd>{{row.category}}</dd></div><div><dt>Entidade</dt><dd>{{label}}</dd></div><div><dt>Status</dt><dd>Exemplo ativo</dd></div></dl></div></article>
{{else}}
  <form class="form-box" method="post" action="{{baseUrl}}"><div class="row">{{#each fields}}<div class="col-12 col-md-6"><label for="{{name}}">{{label}}<input id="{{name}}" name="{{name}}" type="text" required placeholder="Digite {{labelLower}}"></label></div>{{/each}}</div><div class="action-links mt-2"><a class="link-pill" href="{{baseUrl}}">Cancelar</a><a href="#" class="link-pill primary" onclick="this.closest('form').submit(); return false;">Salvar cadastro</a></div></form>
{{/if}}
