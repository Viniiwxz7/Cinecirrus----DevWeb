<section class="hero">
  <p class="eyebrow">Parte 1 + Parte 4</p>
  <h1>CineCirrus: catálogo de cinema</h1>
  <p>Projeto básico usando Express, Handlebars, Sequelize e Cirrus CSS.</p>
  <div class="action-links"><a class="link-pill primary" href="/componentes">Ver componentes</a></div>
</section>
<div class="section-heading"><div><p class="eyebrow">Módulos do projeto</p><h2>Escolha uma entidade</h2></div><span class="chip">Banco SQLite</span></div>
<div class="row">
  {{#each entities}}
    <div class="col-12 col-md-6 col-lg-3"><article class="card entity-card"><div class="card__container">
      <span class="eyebrow">{{icon}} entidade</span><h3 class="card__title">{{plural}}</h3>
      <p class="card__content">CRUD com telas de listar, detalhar e cadastrar.</p>
      <div class="card__footer action-links"><a class="link-pill" href="{{url}}">Listar</a><a class="link-pill primary" href="{{url}}/cadastrar">Cadastrar</a></div>
    </div></article></div>
  {{/each}}
</div>
<h2 class="mt-2">Fluxo exigido</h2>
<div class="row">{{#each flows}}<div class="col-12 col-md-4"><div class="notice"><strong>{{number}}. {{name}}</strong><br>{{description}}</div></div>{{/each}}</div>
